# This file is an example only. ASP.NET Core does not load .env files automatically.
# Set these as environment variables in your shell, IDE launch profile, CI/CD pipeline,
# or hosting platform before starting each service.

# Shared message bus library
SERVICEMESH_SERVICEBUS__ConnectionString=replace-with-service-bus-connection-string

# Web
SERVICEMESH_WEB__ServiceUrls__ProductAPI=https://localhost:7000
SERVICEMESH_WEB__ServiceUrls__CouponAPI=https://localhost:7001
SERVICEMESH_WEB__ServiceUrls__AuthAPI=https://localhost:7002
SERVICEMESH_WEB__ServiceUrls__ShoppingCartAPI=https://localhost:7003
SERVICEMESH_WEB__ServiceUrls__OrderAPI=https://localhost:7004

# Gateway
SERVICEMESH_GATEWAY__ApiSettings__Secret=replace-with-jwt-signing-secret
SERVICEMESH_GATEWAY__ApiSettings__Issuer=servicemesh-auth-api
SERVICEMESH_GATEWAY__ApiSettings__Audience=servicemesh-client

# Auth API
SERVICEMESH_AUTHAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_Auth;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_AUTHAPI__ApiSettings__JwtOptions__Secret=replace-with-jwt-signing-secret
SERVICEMESH_AUTHAPI__ApiSettings__JwtOptions__Issuer=servicemesh-auth-api
SERVICEMESH_AUTHAPI__ApiSettings__JwtOptions__Audience=servicemesh-client
SERVICEMESH_AUTHAPI__TopicAndQueueNames__RegisterUserQueue=registeruser

# Product API
SERVICEMESH_PRODUCTAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_Product;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_PRODUCTAPI__ApiSettings__Secret=replace-with-jwt-signing-secret
SERVICEMESH_PRODUCTAPI__ApiSettings__Issuer=servicemesh-auth-api
SERVICEMESH_PRODUCTAPI__ApiSettings__Audience=servicemesh-client

# Coupon API
SERVICEMESH_COUPONAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_Coupon;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_COUPONAPI__Stripe__SecretKey=replace-with-stripe-secret-key
SERVICEMESH_COUPONAPI__ApiSettings__Secret=replace-with-jwt-signing-secret
SERVICEMESH_COUPONAPI__ApiSettings__Issuer=servicemesh-auth-api
SERVICEMESH_COUPONAPI__ApiSettings__Audience=servicemesh-client

# Shopping Cart API
SERVICEMESH_SHOPPINGCARTAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_ShoppingCart;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_SHOPPINGCARTAPI__ApiSettings__Secret=replace-with-jwt-signing-secret
SERVICEMESH_SHOPPINGCARTAPI__ApiSettings__Issuer=servicemesh-auth-api
SERVICEMESH_SHOPPINGCARTAPI__ApiSettings__Audience=servicemesh-client
SERVICEMESH_SHOPPINGCARTAPI__ServiceUrls__ProductAPI=https://localhost:7000
SERVICEMESH_SHOPPINGCARTAPI__ServiceUrls__CouponAPI=https://localhost:7001
SERVICEMESH_SHOPPINGCARTAPI__TopicAndQueueNames__EmailShoppingCartQueue=emailshoppingcart

# Order API
SERVICEMESH_ORDERAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_Order;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_ORDERAPI__ApiSettings__Secret=replace-with-jwt-signing-secret
SERVICEMESH_ORDERAPI__ApiSettings__Issuer=servicemesh-auth-api
SERVICEMESH_ORDERAPI__ApiSettings__Audience=servicemesh-client
SERVICEMESH_ORDERAPI__ServiceUrls__ProductAPI=https://localhost:7000
SERVICEMESH_ORDERAPI__Stripe__SecretKey=replace-with-stripe-secret-key
SERVICEMESH_ORDERAPI__TopicAndQueueNames__OrderCreatedTopic=OrderCreated
SERVICEMESH_ORDERAPI__TopicAndQueueNames__OrderCreated_Rewards_Subscription=OrderCreatedRewardsUpdate

# Email API
SERVICEMESH_EMAILAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_Email;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_EMAILAPI__ServiceBusConnectionString=replace-with-service-bus-connection-string
SERVICEMESH_EMAILAPI__TopicAndQueueNames__EmailShoppingCartQueue=emailshoppingcart
SERVICEMESH_EMAILAPI__TopicAndQueueNames__RegisterUserQueue=registeruser
SERVICEMESH_EMAILAPI__TopicAndQueueNames__OrderCreatedTopic=OrderCreated
SERVICEMESH_EMAILAPI__TopicAndQueueNames__OrderCreated_Email_Subscription=OrderCreatedEmail

# Reward API
SERVICEMESH_REWARDAPI__ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=ServiceMesh_Reward;Trusted_Connection=True;TrustServerCertificate=True
SERVICEMESH_REWARDAPI__ServiceBusConnectionString=replace-with-service-bus-connection-string
SERVICEMESH_REWARDAPI__TopicAndQueueNames__OrderCreatedTopic=OrderCreated
SERVICEMESH_REWARDAPI__TopicAndQueueNames__OrderCreated_Rewards_Subscription=OrderCreatedRewardsUpdate
