{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "replace-with-authapi-production-connection-string"
  },
  "ApiSettings": {
    "JwtOptions": {
      "Secret": "replace-with-jwt-signing-secret",
      "Issuer": "servicemesh-auth-api",
      "Audience": "servicemesh-client"
    }
  },
  "TopicAndQueueNames": {
    "RegisterUserQueue": "registeruser"
  }
}
